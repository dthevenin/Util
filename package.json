{
  "name": "vs_utils",
  "version": "0.0.1",
  "description": "Set of utilities functions we need for developing web app.",
  "repository": "https://github.com/dthevenin/Util.git",
  "author": "<david@thevenin.jp>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublish": "npm run clean && npm run build",
    "tsc": "node node_modules/typescript/bin/tsc -p src/tsconfig.json",
    "make-bundle": "rollup --config",
    "build": "npm run clean; npm run tsc; npm run make-bundle; rimraf build",
    "typecheck:test": "node node_modules/typescript/bin/tsc -p test/tsconfig.json",
    "test": "nyc mocha --recursive 'test/**/*.spec.ts'"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=15.0.0"
  },
  "type": "module",
  "types": "./dist/vs_utils.d.js",
  "exports": {
    ".": {
      "import": "./dist/vs_utils.es.js",
      "require": "./dist/vs_utils.amd.js",
      "types": "./dist/vs_utils.d.js"
    }
  }
}
